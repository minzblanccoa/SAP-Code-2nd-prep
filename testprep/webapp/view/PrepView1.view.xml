<mvc:View controllerName="testprep.testprep.controller.PrepView1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page   id = "page"
            title = "{i18n>title}"
            showHeader = "false"
            enableScrolling = "true"
            class = "sapUiContentPadding">



        <Panel  headerText = "구구단 계산기"
                class = "sapUiSmallMarginBottom"
                width="20rem">
            <HBox alignItems="Center">
                <Text   text = "단 입력" />
                <Input  id = "gugu"
                        width = "5rem" />
            </HBox>
            <VBox>
                <Button text = "Case 1"
                        press = "onCalcul()" />
            </VBox>
        </Panel>



        <Panel  headerText="반복문 변형"
                class = "sapUiSmallMarginBottom"
                width="20rem">
            <VBox>
                <HBox alignItems="Center">
                    <Button text = "FOR"
                            press = "forClick()" />
                    <Button text = "WHILE"
                            press = "whileClick()" />
                    <Button text = "FOR + WHILE"
                            press = "mixClick()" />
                </HBox>
            </VBox>
        </Panel>



        <Panel  headerText = "Continue 응용"
                class = "sapUiSmallMarginBottom"
                width = "20rem">
            <HBox alignItems="Center">
                <Text text = "단 입력" />
                <Input  id = "skipDan" 
                        width = "2rem"/>
            </HBox>
            <VBox>
                <Button text = "Calcul"
                        press = "skipCalcul()" />
            </VBox>
        </Panel>



        <Panel  headerText = "홀수단 출력"
                class = "sapUiSmallMarginBottom"
                width = "20rem">

            <Button text = "Calcul"
                    press = "oddNumber()" />

        </Panel>



    </Page>
</mvc:View>